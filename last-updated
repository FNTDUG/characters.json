<style>
.updated-panel,
.updated-panel * {
  font-family: 'Press Start 2P', cursive !important;
  box-sizing: border-box;
}

.updated-panel h3 {
  font-family: 'Audiowide', sans-serif !important;
}

@keyframes updatedShiny {
  0%   { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}

/* ------------------------------------------------
   MAIN CONTAINER
------------------------------------------------ */
.updated-panel {
  max-width: 650px;
  width: 95%;
  margin: 30px auto;

  background-color: #08080f;
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0px,
    transparent 3px,
    rgba(0, 0, 0, 0.07) 3px,
    rgba(0, 0, 0, 0.07) 4px
  );

  border: 2px solid #ffa45b;
  border-radius: 18px;

  box-shadow:
    0 0 0 1px rgba(255, 164, 91, 0.2),
    0 0 35px 8px rgba(104, 31, 98, 0.55),
    0 0 70px 20px rgba(104, 31, 98, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);

  color: #fff;
  position: relative;
}

/* scanline overlay */
.updated-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0px,
    transparent 3px,
    rgba(0, 0, 0, 0.06) 3px,
    rgba(0, 0, 0, 0.06) 4px
  );
  pointer-events: none;
  z-index: 1;
  border-radius: inherit;
}

/* ------------------------------------------------
   HEADER
------------------------------------------------ */
.updated-header {
  background: linear-gradient(180deg,
    #120326 0%,
    #3a0a38 30%,
    #681f62 55%,
    #3a0a38 78%,
    #120326 100%
  );
  padding: 20px 48px 18px;
  text-align: center;
  position: relative;
  border-bottom: 2px solid #ffa45b;
  overflow: hidden;
  border-radius: 16px 16px 0 0;
}

/* corner diamonds */
.updated-header::before,
.updated-header::after {
  content: '◆';
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14px;
  color: #ffa45b;
  opacity: 0.5;
  font-family: 'Press Start 2P', cursive !important;
  pointer-events: none;
}
.updated-header::before { left: 14px; }
.updated-header::after  { right: 14px; }

.updated-header h3 {
  font-size: 18px;
  margin: 0;
  color: #fff;
  letter-spacing: 1px;
  text-shadow:
    0 0 6px #ffa45b,
    0 0 18px rgba(255, 164, 91, 0.45),
    0 0 36px rgba(255, 164, 91, 0.18);
}

/* ------------------------------------------------
   BODY
------------------------------------------------ */
.updated-body {
  padding: 16px 14px;
  position: relative;
  z-index: 2;
}

.updated-grid-wrapper {
  display: flex;
  justify-content: center;
  width: 100%;
}

.updated-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-start;
  gap: 6px;

  width: max-content;
  max-width: calc(84px * 7 + 6px * 6);
}

/* ------------------------------------------------
   UNIT CARDS
------------------------------------------------ */
.updated-card {
  width: 84px;
  height: 84px;
  min-width: 84px;
  min-height: 84px;
  max-width: 84px;
  max-height: 84px;
  flex: none;

  border-radius: 10px;
  overflow: hidden;
  position: relative;
  cursor: pointer;

  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.updated-card img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  background: rgba(10, 8, 22, 0.9);
  image-rendering: auto;
  image-rendering: crisp-edges;
  image-rendering: -webkit-optimize-contrast;
}

.updated-card:hover {
  transform: translateY(-2px) scale(1.06);
  box-shadow: 0 0 14px rgba(255, 164, 91, 0.55);
}

/* gradient border via ::before mask trick */
.updated-card::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 2px;
  border-radius: inherit;
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

/* ------------------------------------------------
   RARITY BACKGROUNDS + BORDERS
------------------------------------------------ */
.rarity-uncommon {
  background: linear-gradient(90deg,#5CFF4D,#3FFF8F);
}
.rarity-uncommon::before {
  background: linear-gradient(90deg,#5CFF4D,#3FFF8F);
}

.rarity-rare {
  background: linear-gradient(90deg,#58A6FF,#1C3AA0);
}
.rarity-rare::before {
  background: linear-gradient(90deg,#58A6FF,#1C3AA0);
}

.rarity-epic {
  background: linear-gradient(90deg,#FF35FF,#87009F);
}
.rarity-epic::before {
  background: linear-gradient(90deg,#FF35FF,#87009F);
}

.rarity-mythic {
  background: linear-gradient(90deg,#FFB81F,#FFFF00);
}
.rarity-mythic::before {
  background: linear-gradient(90deg,#FFB81F,#FFFF00);
}

.rarity-secret {
  background: linear-gradient(90deg,#FF8800,#FF0C0C);
}
.rarity-secret::before {
  background: linear-gradient(90deg,#FF8800,#FF0C0C);
}

.rarity-nightmare {
  background: linear-gradient(90deg,#492590,#2A1E42);
}
.rarity-nightmare::before {
  background: linear-gradient(90deg,#492590,#2A1E42);
}

.rarity-exclusive {
  background: linear-gradient(90deg,rgb(140,255,203) 0%,rgb(20,115,91) 25.1%,rgb(51,231,255) 50%,rgb(20,68,112) 68%,rgb(21,74,118) 74.6%,rgb(79,164,255) 100%);
}
.rarity-exclusive::before {
  background: linear-gradient(180deg,rgb(140,255,203) 0%,rgb(20,115,91) 25.1%,rgb(51,231,255) 50%,rgb(20,68,112) 68%,rgb(21,74,118) 74.6%,rgb(79,164,255) 100%);
}

.rarity-apex {
  background: linear-gradient(90deg,#9D0078,#0063F8);
}
.rarity-apex::before {
  background: linear-gradient(90deg,#9D0078,#0063F8);
}

.rarity-hero {
  background: linear-gradient(90deg,#FFCD19,#353815,#FFFB85);
}
.rarity-hero::before {
  background: linear-gradient(90deg,#FFCD19,#353815,#FFFB85);
}

.rarity-shiny {
  background: linear-gradient(90deg, red, orange, yellow, lime, cyan, blue, magenta, red);
  background-size: 300% 300%;
  animation: updatedShiny 6s linear infinite;
}
.rarity-shiny::before {
  background: linear-gradient(90deg, red, orange, yellow, lime, cyan, blue, magenta, red);
  background-size: 200% 200%;
  animation: updatedShiny 6s linear infinite;
}

.rarity-radiant {
  background: linear-gradient(90deg, #FF6600, #FFCC33);
}
.rarity-radiant::before {
  background: linear-gradient(90deg, #FF6600, #FFCC33);
}

/* ------------------------------------------------
   MOBILE
------------------------------------------------ */
@media (max-width: 600px) {
  .updated-header {
    padding: 16px 30px 14px;
  }

  .updated-header h3 {
    font-size: 13px;
  }

  .updated-grid {
    width: 100% !important;
    max-width: 100%;
    justify-content: center;
  }

  .updated-card {
    width: 60px;
    height: 60px;
    min-width: 60px;
    min-height: 60px;
    max-width: 60px;
    max-height: 60px;
    flex: 0 0 60px;
    border-radius: 8px;
  }

  .updated-card::before {
    border-radius: 8px;
  }
}
</style>

<div class="updated-panel">
  <div class="updated-header">
    <h3>Last Added/Updated</h3>
  </div>

  <div class="updated-body">
    <div class="updated-grid-wrapper">
      <div class="updated-grid" id="updatedGrid"></div>
    </div>
  </div>
</div>

<script>
/* ── EDIT THIS LIST ── */
var UPDATED_UNITS = [
"Planet Buster Scott",
"Mr. Hippo",
"Nightguard Afton",
"Into the Pit Spring Bonnie",
"Happy Frog",
"Dee Dee",
"Phone Guy",
"Overlord Scott",
"Anniversary Duo",
"Anniversary Balloon Boy",
"Eleanor",
"Samurai Duo",
"XOR",
"Stitchwraith",
"Hoax Purple Guy",
"Theory Crusher Scott",
"Nedd Bear",
"Count the Ways Funtime Freddy",
"Ragequit Scott",
"Pigpatch",
"Orville Elephant",
"Scott Plushie",
"Vengeful Spirit",
"Scott Cawthon"

];
/* ────────────────── */

var UNITS_JSON_URL = 'https://raw.githubusercontent.com/FNTDUG/characters.json/refs/heads/main/json';

(function () {
  var grid = document.getElementById('updatedGrid');
  if (!grid) return;

  fetch(UNITS_JSON_URL)
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var map = {};
      data.forEach(function (u) { if (u.name) map[u.name] = u; });

      var RARITY_ORDER = ["hero","shiny","apex","exclusive","nightmare","secret","mythic","epic","rare","uncommon"];
      function rarityRank(name) {
        var u = map[name];
        var r = u ? (u.rarity || '').toLowerCase() : '';
        var idx = RARITY_ORDER.indexOf(r);
        return idx === -1 ? 999 : idx;
      }

      var sorted = UPDATED_UNITS.slice().sort(function (a, b) {
        return rarityRank(a) - rarityRank(b);
      });

      sorted.forEach(function (name) {
        var u = map[name];
        var card = document.createElement('div');
        card.className = 'updated-card rarity-' + ((u && u.rarity) ? u.rarity.toLowerCase() : 'rare');
        card.setAttribute('data-unit', name);

        var img = document.createElement('img');
        img.src = (u && (u.imgNormal || u.img)) || '';
        img.alt = name;
        img.loading = 'lazy';

        card.appendChild(img);
        grid.appendChild(card);
      });
    })
    .catch(function () {
      UPDATED_UNITS.forEach(function (name) {
        var card = document.createElement('div');
        card.className = 'updated-card rarity-rare';
        card.setAttribute('data-unit', name);
        grid.appendChild(card);
      });
    });
}());

function smoothScrollToY(targetY, duration) {
  duration = duration || 700;
  var startY = window.scrollY;
  var delta  = targetY - startY;
  var start  = performance.now();

  function easeInOut(t) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  function frame(now) {
    var p = Math.min((now - start) / duration, 1);
    window.scrollTo(0, startY + delta * easeInOut(p));
    if (p < 1) requestAnimationFrame(frame);
  }

  requestAnimationFrame(frame);
}

document.addEventListener('click', function (e) {
  var card = e.target.closest('.updated-card');
  if (!card) return;

  var unitName = card.getAttribute('data-unit');
  if (!unitName) return;

  var engine = document.getElementById('unitEngine');
  var input  = document.getElementById('unitSearch');
  if (!engine || !input) return;

  input.value = unitName;
  input.dispatchEvent(new Event('input', { bubbles: true }));

  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      var engineTop = engine.getBoundingClientRect().top + window.pageYOffset;
      smoothScrollToY(engineTop + 160, 750);
    });
  });

  setTimeout(function () {
    input.focus();
    input.value = unitName;
    input.dispatchEvent(new Event('input', { bubbles: true }));
    input.dispatchEvent(new KeyboardEvent('keydown', {
      key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true
    }));
  }, 750);
});
</script>
